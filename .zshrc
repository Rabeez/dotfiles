eval "$(starship init zsh)"

# Longer shell history
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=1000000000
export SAVEHIST=1000000000
setopt EXTENDED_HISTORY

# Disable terminal flow control (XON/XOFF).
# By default ctrl+s freezes terminal output and ctrl+q resumes it, which is a
# relic almost nobody wants. Disabling it frees ctrl+s -- herdr uses it to
# toggle the sidebar, and it stops accidental "my terminal is frozen" hangs
# in plain shells and under tmux.
[[ $- == *i* ]] && stty -ixon 2>/dev/null

# Start tmux properly
function tt() {
    if command -v tmux &>/dev/null && command -v sesh &>/dev/null && [ -z "$TMUX" ]; then
        TMUX_DEFAULT_SESSION="main"
        # Check if the session already exists
        if tmux has-session -t "$TMUX_DEFAULT_SESSION" 2>/dev/null; then
            # Attach to existing session
            tmux attach-session -t "$TMUX_DEFAULT_SESSION"
        else
            # Create new session with sesh
            sesh connect "$TMUX_DEFAULT_SESSION" || tmux new-session -s "$TMUX_DEFAULT_SESSION"
        fi
    fi
}

# Start herdr (persistent multiplexer — the server restores session.json itself)
#
# Mirrors tt: guard on dependencies, refuse to nest, and guarantee a default
# "main" workspace the way tt guarantees a "main" tmux session.
#
# Difference from tt, deliberately: tt always attaches to "main", but herdr
# restores the workspace/tab/pane layout including which workspace was focused.
# Force-focusing "main" every launch would throw that away, so "main" is only
# focused when the restored session had nothing in it. Otherwise it is merely
# ensured to exist and you land back where you left off.
function th() {
    # Dependency guard (tt requires tmux + sesh; herdr needs herdr + jq,
    # the latter for the prefix+f / prefix+w popups).
    local missing=()
    command -v herdr &>/dev/null || missing+=(herdr)
    command -v jq &>/dev/null || missing+=(jq)
    if ((${#missing[@]})); then
        echo "th: missing required command(s): ${missing[*]}" >&2
        return 1
    fi

    # Forward arguments straight through: th workspace list, th server stop, ...
    if [ $# -gt 0 ]; then
        herdr "$@"
        return
    fi

    # Don't nest inside an existing herdr pane (mirrors tt's $TMUX guard)
    if [ -n "$HERDR_ENV" ]; then
        echo "already inside herdr" >&2
        return 1
    fi

    local default_ws="main"

    # Start the server detached if it isn't up, so we can inspect the restored
    # session before attaching. herdr restores session.json as it starts.
    if ! herdr workspace list &>/dev/null; then
        herdr server &>/dev/null &
        local i
        for i in {1..50}; do
            herdr workspace list &>/dev/null && break
            sleep 0.1
        done
        if ! herdr workspace list &>/dev/null; then
            echo "th: herdr server did not start within 5s" >&2
            return 1
        fi
    fi

    # Ensure "main" exists. Only focus it when the session came up empty --
    # never override a restored focus.
    local ws_json count main_id
    ws_json=$(herdr workspace list 2>/dev/null)
    count=$(printf '%s' "$ws_json" | jq -r '.result.workspaces | length' 2>/dev/null)
    main_id=$(printf '%s' "$ws_json" \
        | jq -r --arg l "$default_ws" \
            '.result.workspaces[] | select(.label == $l) | .workspace_id' 2>/dev/null \
        | head -1)

    if [ -z "$main_id" ]; then
        if [ "${count:-0}" -eq 0 ]; then
            herdr workspace create --cwd "$HOME" --label "$default_ws" --focus &>/dev/null
        else
            herdr workspace create --cwd "$HOME" --label "$default_ws" --no-focus &>/dev/null
        fi
    fi

    # Attach to the running server (this blocks until detach).
    herdr
}

